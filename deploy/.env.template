# Loki pilot configuration: /opt/loki/loki.env (chmod 600, owner root).
# install.sh writes this file from prompts/flags and generates the secrets marked [generated].
# Never commit a filled-in copy. See PILOT_RUNBOOK.md ("Secrets") for docker secrets / SOPS.

# ============================ REQUIRED ============================
# DNS A/AAAA record -> this VPS
LOKI_DOMAIN=loki.customer.example.com
# Let's Encrypt account e-mail
LOKI_ACME_EMAIL=ops@example.com
# used in Slack "View trace" links and doctor
LOKI_PUBLIC_URL=https://loki.customer.example.com
LOKI_IMAGE=ghcr.io/omprakash0310/loki-agent
# image tag; upgrade.sh changes this
LOKI_VERSION=0.1.0
# [generated] hex, URL-safe
POSTGRES_PASSWORD=
# Comma-separated name:key[:scopes] (scopes read | write | read+write).
# [generated] admin:<64 hex>,mcp:<64 hex>:read
LOKI_API_KEYS=
# [generated] ?token= for /alerts* webhooks
LOKI_WEBHOOK_TOKEN=
# forced to 1 by docker-compose.yml anyway
LOKI_REQUIRE_AUTH=1
# claude-haiku-4-5 | claude-sonnet-5 | claude-opus-5 | fake (tests only)
LOKI_MODEL=claude-haiku-4-5
# the customer's or operator's key
ANTHROPIC_API_KEY=

# Signs Slack "View trace" links (/share/trace/...).
# [generated]
LOKI_LINK_SECRET=
# Share link lifetime in seconds.
# LOKI_LINK_TTL_S=   (unset = built-in default; an empty value is NOT the same)

# ======================= INTEGRATIONS (customer systems) =======================
# Metrics: the customer's Prometheus (or Mimir/Thanos query URL). Empty = no metrics.
LOKI_PROM_URL=
# Credentials for it, if it needs any (leave empty otherwise). Bearer token, or basic auth
# (Grafana Cloud: user = instance id, password = API token), plus a tenant id for Mimir.
LOKI_PROM_BEARER_TOKEN=
LOKI_PROM_BASIC_USER=
LOKI_PROM_BASIC_PASSWORD=
LOKI_PROM_ORG_ID=
# default | otel | spring | express-prom (scripts/discover_metrics.py helps)
LOKI_METRICS_PRESET=default
# path INSIDE the container to a JSON override (mount it)
LOKI_METRICS_CONFIG=
# Logs: the customer's Grafana Loki base URL (name is historical: LOKI_URL = Grafana Loki).
LOKI_URL=
# Same, for the Grafana Loki above.
LOKI_LOGS_BEARER_TOKEN=
LOKI_LOGS_BASIC_USER=
LOKI_LOGS_BASIC_PASSWORD=
LOKI_LOGS_ORG_ID=
# loki (Grafana Loki at LOKI_URL) | sentry | datadog. Set it once the source is configured; doctor checks it.
LOKI_ERRORS_SOURCE=
# github (recommended) | file. Empty = no deploy history.
LOKI_DEPLOYS_SOURCE=
# GitHub fine-grained token, read-only: Metadata, Contents, Deployments, Pull requests.
GITHUB_TOKEN=
# owner/repo=service,owner/repo2=service2
GITHUB_REPOS=
# e.g. production
GITHUB_ENVIRONMENT=
# GitHub Enterprise only
GITHUB_API_URL=
# GITHUB_LOOKBACK_HOURS=   (unset = built-in default; an empty value is NOT the same)
# Sentry token with project:read, event:read.
SENTRY_TOKEN=
SENTRY_ORG=
# project-slug=service,...
SENTRY_PROJECTS=
# https://de.sentry.io for EU
SENTRY_BASE_URL=
# internal integration Client Secret (signature check)
SENTRY_WEBHOOK_SECRET=
# V3 webhook signing secret
PAGERDUTY_WEBHOOK_SECRET=
# Datadog logs (read-only). Set LOKI_ERRORS_SOURCE=datadog to use it.
# Classic keys (the application key needs the logs_read_data permission), or a token:
DATADOG_API_KEY=
DATADOG_APP_KEY=
# DATADOG_TOKEN=   (personal or service access token instead of the two keys)
# datadoghq.com (default) | datadoghq.eu | us3.datadoghq.com | us5.datadoghq.com | ap1.datadoghq.com
DATADOG_SITE=
# optional extra filter, e.g. env:production
DATADOG_LOG_QUERY=
# Slack (shadow mode: a PRIVATE channel for the first 2 weeks). deploy/slack-app-manifest.yml
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_SIGNING_SECRET=
# fallback without buttons
SLACK_WEBHOOK_URL=

# ===================== SIMILAR PAST INCIDENTS =====================
# Find confirmed past incidents by meaning with a small local model (no data leaves the server).
# local (compose default) | off (keyword search only)
LOKI_EMBEDDINGS=local
# LOKI_EMBEDDING_MODEL=   (unset = BAAI/bge-small-en-v1.5, baked into the image)
# LOKI_EMBEDDING_CACHE=   (unset = /opt/models in the image)
# How close a past incident must be to be added to the briefing as a lead (0-1).
# LOKI_HINT_MIN_SIMILARITY=   (unset = 0.75)

# ============================ MANY CUSTOMERS ============================
# One server can serve several customers (tenants). This file configures the default one;
# others are added with POST /tenants and configured with PUT /tenants/<id>/settings.
# Encrypts other customers' secrets in the database. Generate once and keep it safe:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOKI_SECRET_KEY=
# A customer's metric names as JSON, set per tenant (the default tenant uses LOKI_METRICS_CONFIG).
# LOKI_METRICS_CONFIG_JSON=   (per tenant only)
# Daily spend cap across every customer together (each also has LOKI_DAILY_BUDGET_USD).
# LOKI_TOTAL_DAILY_BUDGET_USD=   (unset = no cap across customers)

# One-page setup (/setup/<link>): customers connect Slack and GitHub by clicking.
# Register Loki's Slack app once (deploy/slack-app-manifest.yml, public distribution on):
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# ...and Loki's GitHub App once (PILOT_RUNBOOK.md section 10c): its id, URL name and private key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The .pem's contents on one line with \n escapes, or a path inside the container:
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=

# ============================ LIMITS ============================
# per investigation
LOKI_MAX_COST_USD=0.10
# all investigations per day
LOKI_DAILY_BUDGET_USD=5.00
LOKI_MAX_STEPS=8
# e.g. claude-sonnet-5 when unsure (costs more)
LOKI_ESCALATE_MODEL=
LOKI_ESCALATE_BELOW=0.6

# ======================= SELF-MONITORING (operator) =======================
# OPERATOR's incoming webhook: repeated investigation failures
LOKI_OPERATOR_SLACK_WEBHOOK=
# failures ...
LOKI_FAILURE_ALERT_THRESHOLD=3
# ... within this many minutes
LOKI_FAILURE_ALERT_WINDOW_MIN=30
# at most one alert per hour
LOKI_FAILURE_ALERT_COOLDOWN_MIN=60

# ============================ BACKUPS ============================
LOKI_BACKUP_DIR=/opt/loki/backups
LOKI_BACKUP_KEEP_DAYS=7
# optional, e.g. s3remote:loki-backups/customer-a (rclone on the host)
LOKI_BACKUP_RCLONE_REMOTE=

# ============================ OPTIONAL ============================
# empty = on for Claude models; 1/0 forces
LOKI_CRITIC=
LOKI_CRITIC_MODEL=claude-haiku-4-5
LOKI_LESSONS=1
LOKI_LESSONS_MODEL=claude-haiku-4-5
# self-hosted model instead of Anthropic
LOKI_OLLAMA_URL=
# Verification and live probes stay OFF for pilots (verification needs a Docker socket).
LOKI_VERIFY=0
# LOKI_VERIFY_IMAGE_TEMPLATE=   (unset = built-in default; an empty value is NOT the same)
# LOKI_VERIFY_INIT_SQL=   (unset = built-in default; an empty value is NOT the same)
# LOKI_VERIFY_POSTGRES_IMAGE=   (unset = built-in default; an empty value is NOT the same)
# LOKI_VERIFY_TIMEOUT_S=   (unset = built-in default; an empty value is NOT the same)
LOKI_PROBES=0
# [generated] only used if probes are enabled later
LOKI_PROBE_TOKEN=
# LOKI_PROBE_ENDPOINTS=   (unset = built-in default; an empty value is NOT the same)
# LOKI_PROBE_MAX_PER_INVESTIGATION=   (unset = built-in default; an empty value is NOT the same)
# Local testing only (Caddy internal CA, other host ports):
LOKI_CADDYFILE=Caddyfile
LOKI_HTTP_PORT=80
LOKI_HTTPS_PORT=443
