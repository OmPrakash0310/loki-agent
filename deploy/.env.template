# Loki pilot configuration: /opt/loki/loki.env (chmod 600, owner root).
# install.sh writes this file from prompts/flags and generates the secrets marked [generated].
# Never commit a filled-in copy. See PILOT_RUNBOOK.md ("Secrets") for docker secrets / SOPS.

# ============================ REQUIRED ============================
# DNS A/AAAA record -> this VPS
LOKI_DOMAIN=loki.customer.example.com
# Let's Encrypt account e-mail
LOKI_ACME_EMAIL=ops@example.com
# used in Slack "View trace" links and doctor
LOKI_PUBLIC_URL=https://loki.customer.example.com
LOKI_IMAGE=ghcr.io/turbotrade-tt/loki-agent
# image tag; upgrade.sh changes this
LOKI_VERSION=0.1.0
# [generated] hex, URL-safe
POSTGRES_PASSWORD=
# Comma-separated name:key[:scopes] (scopes read | write | read+write).
# [generated] admin:<64 hex>,mcp:<64 hex>:read
LOKI_API_KEYS=
# [generated] ?token= for /alerts* webhooks
LOKI_WEBHOOK_TOKEN=
# forced to 1 by docker-compose.yml anyway
LOKI_REQUIRE_AUTH=1
# claude-haiku-4-5 | claude-sonnet-5 | claude-opus-5 | fake (tests only)
LOKI_MODEL=claude-haiku-4-5
# the customer's or operator's key
ANTHROPIC_API_KEY=

# ======================= INTEGRATIONS (customer systems) =======================
# Metrics: the customer's Prometheus (or Mimir/Thanos query URL). Empty = no metrics.
LOKI_PROM_URL=
# default | otel | spring | express-prom (scripts/discover_metrics.py helps)
LOKI_METRICS_PRESET=default
# path INSIDE the container to a JSON override (mount it)
LOKI_METRICS_CONFIG=
# Logs: the customer's Grafana Loki base URL (name is historical: LOKI_URL = Grafana Loki).
LOKI_URL=
# loki | sentry
LOKI_ERRORS_SOURCE=sentry
# file | github
LOKI_DEPLOYS_SOURCE=github
# GitHub fine-grained token, read-only: Metadata, Contents, Deployments, Pull requests.
GITHUB_TOKEN=
# owner/repo=service,owner/repo2=service2
GITHUB_REPOS=
# e.g. production
GITHUB_ENVIRONMENT=
# GitHub Enterprise only
GITHUB_API_URL=
# GITHUB_LOOKBACK_HOURS=   (unset = built-in default; an empty value is NOT the same)
# Sentry token with project:read, event:read.
SENTRY_TOKEN=
SENTRY_ORG=
# project-slug=service,...
SENTRY_PROJECTS=
# https://de.sentry.io for EU
SENTRY_BASE_URL=
# internal integration Client Secret (signature check)
SENTRY_WEBHOOK_SECRET=
# V3 webhook signing secret
PAGERDUTY_WEBHOOK_SECRET=
# Slack (shadow mode: a PRIVATE channel for the first 2 weeks). deploy/slack-app-manifest.yml
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_SIGNING_SECRET=
# fallback without buttons
SLACK_WEBHOOK_URL=

# ============================ LIMITS ============================
# per investigation
LOKI_MAX_COST_USD=0.10
# all investigations per day
LOKI_DAILY_BUDGET_USD=5.00
LOKI_MAX_STEPS=8
# e.g. claude-sonnet-5 when unsure (costs more)
LOKI_ESCALATE_MODEL=
LOKI_ESCALATE_BELOW=0.6

# ======================= SELF-MONITORING (operator) =======================
# OPERATOR's incoming webhook: repeated investigation failures
LOKI_OPERATOR_SLACK_WEBHOOK=
# failures ...
LOKI_FAILURE_ALERT_THRESHOLD=3
# ... within this many minutes
LOKI_FAILURE_ALERT_WINDOW_MIN=30
# at most one alert per hour
LOKI_FAILURE_ALERT_COOLDOWN_MIN=60

# ============================ BACKUPS ============================
LOKI_BACKUP_DIR=/opt/loki/backups
LOKI_BACKUP_KEEP_DAYS=7
# optional, e.g. s3remote:loki-backups/customer-a (rclone on the host)
LOKI_BACKUP_RCLONE_REMOTE=

# ============================ OPTIONAL ============================
# empty = on for Claude models; 1/0 forces
LOKI_CRITIC=
LOKI_CRITIC_MODEL=claude-haiku-4-5
LOKI_LESSONS=1
LOKI_LESSONS_MODEL=claude-haiku-4-5
# self-hosted model instead of Anthropic
LOKI_OLLAMA_URL=
# Verification and live probes stay OFF for pilots (verification needs a Docker socket).
LOKI_VERIFY=0
# LOKI_VERIFY_IMAGE_TEMPLATE=   (unset = built-in default; an empty value is NOT the same)
# LOKI_VERIFY_INIT_SQL=   (unset = built-in default; an empty value is NOT the same)
# LOKI_VERIFY_POSTGRES_IMAGE=   (unset = built-in default; an empty value is NOT the same)
# LOKI_VERIFY_TIMEOUT_S=   (unset = built-in default; an empty value is NOT the same)
LOKI_PROBES=0
# [generated] only used if probes are enabled later
LOKI_PROBE_TOKEN=
# LOKI_PROBE_ENDPOINTS=   (unset = built-in default; an empty value is NOT the same)
# LOKI_PROBE_MAX_PER_INVESTIGATION=   (unset = built-in default; an empty value is NOT the same)
# Local testing only (Caddy internal CA, other host ports):
LOKI_CADDYFILE=Caddyfile
LOKI_HTTP_PORT=80
LOKI_HTTPS_PORT=443
