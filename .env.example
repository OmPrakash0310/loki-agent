# Copy to .env and fill in. .env is git-ignored.

# --- Model --------------------------------------------------------------
# claude-haiku-4-5 (default, cheapest Claude) | claude-sonnet-5 | claude-opus-5
# fake = scripted model, no API calls, $0 (tests the pipeline only)
LOKI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Optional: re-run with a stronger model when the cheap one is unsure (costs more).
# LOKI_ESCALATE_MODEL=claude-sonnet-5
# LOKI_ESCALATE_BELOW=0.6

# --- Spending limits ----------------------------------------------------
LOKI_MAX_COST_USD=0.10       # per investigation
LOKI_DAILY_BUDGET_USD=1.00   # all investigations in a day
LOKI_MAX_STEPS=8

# --- Free alternative: local open-source model through Ollama -----------
# Needs Ollama 0.14+ running on your Mac: ollama pull qwen3:4b
# LOKI_OLLAMA_URL=http://host.docker.internal:11434
# LOKI_MODEL=qwen3:4b

# --- Slack (optional, see README "Slack setup") --------------------------
# Slack app: reports as rich messages with Confirm / Wrong / View trace buttons.
# xoxb-..., needs the chat:write scope
SLACK_BOT_TOKEN=
# channel ID (C0123...) or #name; invite the app to it
SLACK_CHANNEL=
# verifies button clicks really come from Slack
SLACK_SIGNING_SECRET=
# how Slack users reach this agent, for the "View trace" link
LOKI_PUBLIC_URL=
# Fallback: plain-text reports to an incoming webhook (no buttons). Used only
# when SLACK_BOT_TOKEN/SLACK_CHANNEL are not set.
SLACK_WEBHOOK_URL=
