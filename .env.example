# Copy to .env and fill in. .env is git-ignored.

# --- Model --------------------------------------------------------------
# claude-haiku-4-5 (default, cheapest Claude) | claude-sonnet-5 | claude-opus-5
# fake = scripted model, no API calls, $0 (tests the pipeline only)
LOKI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Optional: re-run with a stronger model when the cheap one is unsure (costs more).
# LOKI_ESCALATE_MODEL=claude-sonnet-5
# LOKI_ESCALATE_BELOW=0.6

# --- Spending limits ----------------------------------------------------
LOKI_MAX_COST_USD=0.10       # per investigation
LOKI_DAILY_BUDGET_USD=1.00   # all investigations in a day
LOKI_MAX_STEPS=8

# --- Free alternative: local open-source model through Ollama -----------
# Needs Ollama 0.14+ running on your Mac: ollama pull qwen3:4b
# LOKI_OLLAMA_URL=http://host.docker.internal:11434
# LOKI_MODEL=qwen3:4b

# --- Securing Loki (see README "Securing Loki") -------------------------
# Empty = no auth (local demo only). ANY exposed deployment must set keys.
# Comma-separated name:key[:scopes], scopes read | write | read+write (default).
# e.g. eval:<random>,mcp:<random>:read      generate: openssl rand -hex 32
LOKI_API_KEYS=
# Shared secret for alert webhooks that can't set headers: /alerts?token=...
LOKI_WEBHOOK_TOKEN=
# 1 = refuse to start without LOKI_API_KEYS
LOKI_REQUIRE_AUTH=
# For scripts/*.py and the MCP server (client side): one key from LOKI_API_KEYS.
LOKI_API_KEY=

# --- Slack (optional, see README "Slack setup") --------------------------
# Slack app: reports as rich messages with Confirm / Wrong / View trace buttons.
# xoxb-..., needs the chat:write scope
SLACK_BOT_TOKEN=
# channel ID (C0123...) or #name; invite the app to it
SLACK_CHANNEL=
# verifies button clicks really come from Slack
SLACK_SIGNING_SECRET=
# how Slack users reach this agent, for the "View trace" link
LOKI_PUBLIC_URL=
# Fallback: plain-text reports to an incoming webhook (no buttons). Used only
# when SLACK_BOT_TOKEN/SLACK_CHANNEL are not set.
SLACK_WEBHOOK_URL=

# --- Integrations: investigate a real stack (see README "Integrations") ---
# Empty = the demo: deploys from state/deploys.json, errors from Grafana Loki.
LOKI_DEPLOYS_SOURCE=          # file (default) | github
LOKI_ERRORS_SOURCE=           # loki (default) | sentry

# GitHub: fine-grained token, read-only: Contents, Deployments, Pull requests, Metadata.
GITHUB_TOKEN=
GITHUB_REPOS=                 # owner/repo=service,owner/repo2=service2
GITHUB_ENVIRONMENT=           # optional: only deployments to this environment, e.g. production
GITHUB_API_URL=               # optional: GitHub Enterprise, e.g. https://github.example.com/api/v3

# Sentry: internal-integration or user token with project:read and event:read.
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_PROJECTS=              # project-slug=service,project-slug2=service2
SENTRY_BASE_URL=              # optional: default https://sentry.io (EU: https://de.sentry.io)

# Alert intake webhooks (README "Connecting your alerts"). SENTRY_PROJECTS above also maps
# Sentry alerts to services. Set a secret and Loki rejects webhooks with a wrong signature.
SENTRY_WEBHOOK_SECRET=        # the Sentry internal integration's Client Secret
PAGERDUTY_WEBHOOK_SECRET=     # the V3 webhook subscription's signing secret

# --- Your own metrics (see README "Using your own metrics") ---------------
# Empty = the demo's names: http_requests_total{service,status} and friends.
LOKI_METRICS_PRESET=          # default | otel | spring | express-prom
LOKI_METRICS_CONFIG=          # optional: JSON file overriding single names (mount it into the agent container)
# Leave commented to use the demo Prometheus. Uncommented and empty = no Prometheus at all:
# briefings use logs, errors and deploys only.
# LOKI_PROM_URL=
