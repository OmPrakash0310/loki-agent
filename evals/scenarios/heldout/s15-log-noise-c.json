{
  "id": "s15-log-noise-c",
  "description": "10 unrelated error lines per request in shop-api hide a real payments-side fault.",
  "difficulty": "hard",
  "split": "heldout",
  "fault_types": [
    "dependency_errors",
    "log_noise"
  ],
  "load": {
    "shape": "steady",
    "extra_rps": 0,
    "duration_s": 0
  },
  "deploys": [],
  "steps": [
    {
      "at_s": 0,
      "action": "fault",
      "service": "shop-api",
      "fault": "log_flood",
      "params": {
        "lines_per_request": 10
      }
    },
    {
      "at_s": 40,
      "action": "fault",
      "service": "payments-svc",
      "fault": "card_errors",
      "params": {
        "rate": 1.0,
        "status": 503
      }
    }
  ],
  "ground_truth": {
    "root_cause_service": "card-network",
    "cause_type": "dependency_errors",
    "triggers": [
      "dependency"
    ],
    "deploy_ref": null,
    "acceptable_services": [
      "card-network",
      {
        "service": "payments-svc",
        "if_text_any": [
          "card"
        ]
      }
    ],
    "trap": "shop-api floods unrelated analytics / recs-cache errors",
    "keywords_any": [
      "card"
    ],
    "trap_services": [
      "shop-api"
    ]
  },
  "generator": {
    "mode": "template",
    "template": "log-noise",
    "seed": 1,
    "variant": 2
  }
}
